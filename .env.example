# Port sur lequel le serveur s'exécute
PORT=5000

# URL de connexion à la base de données PostgreSQL (ex: Supabase ou local)
DATABASE_URL=postgresql://postgres:[VOTRE_MOT_DE_PASSE]@db.[VOTRE_PROJECT_REF].supabase.co:5432/postgres

# Supabase API
SUPABASE_URL=https://[VOTRE_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Clés de l'API de test Stripe (à récupérer sur dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Configuration SSO OAuth (Google, Apple, Microsoft) pour le portail restaurateur
GOOGLE_CLIENT_ID=google-oauth-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google-oauth-client-secret-here
APPLE_CLIENT_ID=com.ciaobyebye.auth
MICROSOFT_CLIENT_ID=microsoft-entra-app-client-id-here
